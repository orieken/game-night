rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isOrganizer(groupId) {
      return isMember(groupId) && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'organizer'];
    }

    function invitePath(inviteCode) {
      return /databases/$(database)/documents/eventInvites/$(inviteCode);
    }

    function validInviteForGroup(inviteCode, groupId) {
      return inviteCode is string &&
        exists(invitePath(inviteCode)) &&
        get(invitePath(inviteCode)).data.active == true &&
        get(invitePath(inviteCode)).data.groupId == groupId;
    }

    function validInviteForEvent(inviteCode, groupId, eventId) {
      return validInviteForGroup(inviteCode, groupId) &&
        get(invitePath(inviteCode)).data.eventId == eventId;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn();
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Collection-group membership lookup used to populate the active-table
    // selector. Queries must constrain userId to the signed-in user.
    match /{path=**}/members/{userId} {
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /eventInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.code == inviteCode &&
        request.resource.data.active == true &&
        isOrganizer(request.resource.data.groupId) &&
        getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/events/$(request.resource.data.eventId)).data.hostId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/events/$(request.resource.data.eventId)).data.rsvpInviteCode == inviteCode;
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      function isOwnInviteJoin() {
        let membership = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
        return signedIn() &&
          membership.userId == request.auth.uid &&
          validInviteForGroup(membership.inviteCode, groupId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']) &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
          request.resource.data.memberIds.hasAll([request.auth.uid]) &&
          request.resource.data.memberIds.size() <= resource.data.memberIds.size() + 1;
      }

      function isValidInviteMember(userId) {
        return signedIn() &&
          userId == request.auth.uid &&
          request.resource.data.userId == userId &&
          request.resource.data.role == 'member' &&
          validInviteForGroup(request.resource.data.inviteCode, groupId);
      }

      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      // A personal group uses the owner's uid as its document id. Allowing the
      // owner to get that one path lets first-run provisioning check whether it
      // exists before the membership subdocument has been created.
      allow get: if signedIn() && (groupId == request.auth.uid || isMember(groupId));
      allow list: if isMember(groupId);
      allow update: if isOrganizer(groupId) || isOwnInviteJoin();
      allow delete: if isOrganizer(groupId);

      match /members/{userId} {
        allow get: if isMember(groupId) || (signedIn() && request.auth.uid == userId);
        allow list: if isMember(groupId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if request.resource.data.userId == userId && (
          isOrganizer(groupId) || (
            groupId == request.auth.uid &&
            userId == request.auth.uid &&
            request.resource.data.role == 'owner'
          ) || isValidInviteMember(userId)
        );
        allow update: if (isOrganizer(groupId) && request.resource.data.userId == userId) || (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode']) &&
          validInviteForGroup(request.resource.data.inviteCode, groupId)
        );
        allow delete: if isOrganizer(groupId);
      }

      match /games/{gameId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isOrganizer(groupId);
      }

      match /campaigns/{campaignId} {
        function validCampaign(campaignData) {
          return campaignData.name is string &&
            campaignData.name.size() > 0 &&
            (campaignData.description == null || campaignData.description is string);
        }

        function validCampaignShape(campaignData) {
          return validCampaign(campaignData) &&
            campaignData.system is string &&
            campaignData.system.size() > 0 &&
            (campaignData.variant == null || campaignData.variant is string) &&
            campaignData.status in ['active', 'on_hold', 'completed', 'archived'] &&
            campaignData.dmIds is list &&
            campaignData.dmIds.size() > 0 &&
            campaignData.memberIds is list &&
            campaignData.externalLinks is list &&
            campaignData.characterFieldDefinitions is list &&
            campaignData.createdById is string &&
            campaignData.createdAt is timestamp &&
            campaignData.updatedAt is timestamp;
        }

        function isCampaignManager() {
          return isOrganizer(groupId) ||
            (isMember(groupId) && request.auth.uid in resource.data.dmIds);
        }

        allow read: if isMember(groupId);
        allow create: if isOrganizer(groupId) &&
          validCampaignShape(request.resource.data) &&
          request.resource.data.createdById == request.auth.uid &&
          request.auth.uid in request.resource.data.dmIds &&
          request.auth.uid in request.resource.data.memberIds;
        allow update: if isCampaignManager() &&
          validCampaignShape(request.resource.data) &&
          request.resource.data.createdById == resource.data.createdById &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;

        match /characters/{characterId} {
          function campaignData() {
            return get(/databases/$(database)/documents/groups/$(groupId)/campaigns/$(campaignId)).data;
          }

          function isCampaignParticipant() {
            return isMember(groupId) && (
              request.auth.uid in campaignData().memberIds ||
              request.auth.uid in campaignData().dmIds
            );
          }

          function validCharacter(characterData) {
            return characterData.name is string &&
              characterData.name.size() > 0 &&
              characterData.playerId is string &&
              (characterData.pronouns == null || characterData.pronouns is string) &&
              characterData.status in ['active', 'inactive', 'retired', 'deceased'] &&
              (characterData.portraitUrl == null || characterData.portraitUrl is string) &&
              (characterData.externalSheetUrl == null || characterData.externalSheetUrl is string) &&
              (characterData.publicNotes == null || characterData.publicNotes is string) &&
              characterData.fieldValues is map &&
              characterData.fieldValues.size() <= 50 &&
              characterData.createdById is string &&
              characterData.createdAt is timestamp &&
              characterData.updatedAt is timestamp;
          }

          allow read: if isOrganizer(groupId) || isCampaignParticipant();
          allow create: if isCampaignParticipant() &&
            campaignData().status != 'archived' &&
            validCharacter(request.resource.data) &&
            request.resource.data.playerId == request.auth.uid &&
            request.resource.data.createdById == request.auth.uid;
          allow update: if isCampaignParticipant() &&
            campaignData().status != 'archived' &&
            resource.data.playerId == request.auth.uid &&
            validCharacter(request.resource.data) &&
            request.resource.data.playerId == resource.data.playerId &&
            request.resource.data.createdById == resource.data.createdById &&
            request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if false;
        }

        match /adventureLogs/{logId} {
          function logCampaignData() {
            return get(/databases/$(database)/documents/groups/$(groupId)/campaigns/$(campaignId)).data;
          }

          function isLogParticipant() {
            return isMember(groupId) && (
              request.auth.uid in logCampaignData().memberIds ||
              request.auth.uid in logCampaignData().dmIds
            );
          }

          function isLogManager() {
            return isOrganizer(groupId) ||
              (isMember(groupId) && request.auth.uid in logCampaignData().dmIds);
          }

          function validLinkedEvent(eventId) {
            let eventPath = /databases/$(database)/documents/groups/$(groupId)/events/$(eventId);
            return eventId is string &&
              exists(eventPath) &&
              get(eventPath).data.get('campaignId', null) == campaignId &&
              get(eventPath).data.get('eventType', 'board_game') in ['tabletop_rpg', 'mixed'];
          }

          function validAdventureLog(logData) {
            return validLinkedEvent(logData.eventId) &&
              logData.sessionNumber is int &&
              logData.sessionNumber > 0 &&
              logData.title is string &&
              logData.title.size() > 0 &&
              logData.sessionDate is timestamp &&
              logData.attendeeIds is list &&
              logData.characterIds is list &&
              (logData.recap == null || logData.recap is string) &&
              (logData.progress == null || logData.progress is string) &&
              (logData.loot == null || logData.loot is string) &&
              (logData.quests == null || logData.quests is string) &&
              logData.memorableMoments is list &&
              (logData.nextSessionHooks == null || logData.nextSessionHooks is string) &&
              logData.createdById is string &&
              logData.createdAt is timestamp &&
              logData.updatedAt is timestamp;
          }

          allow read: if isOrganizer(groupId) || isLogParticipant();
          allow create: if isLogManager() &&
            logCampaignData().status != 'archived' &&
            validAdventureLog(request.resource.data) &&
            request.resource.data.createdById == request.auth.uid;
          allow update: if isLogManager() &&
            logCampaignData().status != 'archived' &&
            validAdventureLog(request.resource.data) &&
            request.resource.data.eventId == resource.data.eventId &&
            request.resource.data.createdById == resource.data.createdById &&
            request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if false;
        }
      }

      match /events/{eventId} {
        function eventPath() {
          return /databases/$(database)/documents/groups/$(groupId)/events/$(eventId);
        }

        function rsvpPath(userId) {
          return /databases/$(database)/documents/groups/$(groupId)/events/$(eventId)/rsvps/$(userId);
        }

        function wasGoing(userId) {
          return exists(rsvpPath(userId)) && get(rsvpPath(userId)).data.status == 'going';
        }

        function willBeGoing(userId) {
          return existsAfter(rsvpPath(userId)) && getAfter(rsvpPath(userId)).data.status == 'going';
        }

        function attendanceDelta(userId) {
          return (willBeGoing(userId) ? 1 : 0) - (wasGoing(userId) ? 1 : 0);
        }

        function validAttendanceCount(eventData) {
          return eventData.attendeeCount >= 0 &&
            (eventData.maxAttendees == null || eventData.attendeeCount <= eventData.maxAttendees);
        }

        function validEventType(eventData) {
          return eventData.get('eventType', 'board_game') in ['board_game', 'tabletop_rpg', 'mixed'];
        }

        function validCampaignLink(eventData) {
          let campaignId = eventData.get('campaignId', null);
          return campaignId == null || (
            campaignId is string &&
            eventData.get('eventType', 'board_game') in ['tabletop_rpg', 'mixed'] &&
            exists(/databases/$(database)/documents/groups/$(groupId)/campaigns/$(campaignId))
          );
        }

        function isHostUpdate() {
          return isOrganizer(groupId) &&
            resource.data.hostId == request.auth.uid &&
            request.resource.data.hostId == resource.data.hostId &&
            request.resource.data.attendeeCount == resource.data.get('attendeeCount', 0) &&
            request.resource.data.invitedUserIds is list &&
            request.resource.data.selectedGameIds is list &&
            validEventType(request.resource.data) &&
            validCampaignLink(request.resource.data) &&
            resource.data.status != 'cancelled';
        }

        function isOwnAttendanceUpdate() {
          return isMember(groupId) &&
            resource.data.status == 'upcoming' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount', 'updatedAt']) &&
            request.resource.data.attendeeCount == resource.data.get('attendeeCount', 0) + attendanceDelta(request.auth.uid) &&
            validAttendanceCount(request.resource.data);
        }

        function isInviteAcceptance() {
          let membership = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
          return signedIn() &&
            validInviteForEvent(membership.inviteCode, groupId, eventId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedUserIds', 'updatedAt']) &&
            request.resource.data.invitedUserIds.hasAll(resource.data.invitedUserIds) &&
            request.resource.data.invitedUserIds.hasAll([request.auth.uid]) &&
            request.resource.data.invitedUserIds.size() <= resource.data.invitedUserIds.size() + 1;
        }

        function validOwnRsvp(userId) {
          let eventBefore = get(eventPath()).data;
          let eventAfter = getAfter(eventPath()).data;
          let nextCount = eventBefore.get('attendeeCount', 0) + attendanceDelta(userId);
          return isMember(groupId) &&
            userId == request.auth.uid &&
            request.resource.data.userId == userId &&
            request.resource.data.status in ['going', 'maybe', 'not_going'] &&
            eventBefore.status == 'upcoming' &&
            (eventBefore.isPublic || eventBefore.hostId == userId || userId in eventBefore.get('invitedUserIds', [])) &&
            eventAfter.attendeeCount == nextCount &&
            validAttendanceCount(eventAfter);
        }

        function isEventHost() {
          return isOrganizer(groupId) && get(eventPath()).data.hostId == request.auth.uid;
        }

        function sessionPath(sessionId) {
          return /databases/$(database)/documents/groups/$(groupId)/events/$(eventId)/sessions/$(sessionId);
        }

        allow read: if isMember(groupId);
        allow create: if isOrganizer(groupId) &&
          request.resource.data.hostId == request.auth.uid &&
          request.resource.data.attendeeCount == 0 &&
          request.resource.data.invitedUserIds is list &&
          request.resource.data.selectedGameIds is list &&
          validEventType(request.resource.data) &&
          validCampaignLink(request.resource.data) &&
          validAttendanceCount(request.resource.data);
        allow update: if isHostUpdate() || isOwnAttendanceUpdate() || isInviteAcceptance();
        allow delete: if isOrganizer(groupId) && resource.data.hostId == request.auth.uid;

        match /rsvps/{userId} {
          allow read: if isMember(groupId);
          allow create, update: if validOwnRsvp(userId);
          allow delete: if false;
        }

        match /sessions/{sessionId} {
          allow read: if isMember(groupId);
          allow create: if isEventHost() &&
            get(eventPath()).data.status == 'upcoming' &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.gameId in get(eventPath()).data.selectedGameIds &&
            request.resource.data.status == 'in_progress' &&
            request.resource.data.completedAt == null &&
            (request.resource.data.notes == null || request.resource.data.notes is string);
          allow update: if isEventHost() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']) &&
            request.resource.data.createdBy == resource.data.createdBy &&
            request.resource.data.gameId == resource.data.gameId &&
            request.resource.data.status == 'completed' &&
            request.resource.data.completedAt is timestamp &&
            request.resource.data.updatedAt is timestamp &&
            request.resource.data.updatedAt != resource.data.updatedAt;
          allow delete: if isEventHost();

          match /players/{userId} {
            allow read: if isMember(groupId);
            allow create: if isEventHost() &&
              !exists(sessionPath(sessionId)) &&
              exists(/databases/$(database)/documents/groups/$(groupId)/members/$(userId)) &&
              request.resource.data.userId == userId &&
              request.resource.data.placement == null &&
              request.resource.data.score == null &&
              request.resource.data.isWinner == false &&
              getAfter(sessionPath(sessionId)).data.status == 'in_progress';
            allow update: if isEventHost() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['placement', 'score', 'isWinner']) &&
              request.resource.data.userId == userId &&
              request.resource.data.placement is int &&
              request.resource.data.placement > 0 &&
              (request.resource.data.score == null || request.resource.data.score is number) &&
              request.resource.data.isWinner == (request.resource.data.placement == 1) &&
              getAfter(sessionPath(sessionId)).data.status == 'completed' &&
              getAfter(sessionPath(sessionId)).data.updatedAt != get(sessionPath(sessionId)).data.updatedAt;
            allow delete: if isEventHost() && !existsAfter(sessionPath(sessionId));
          }
        }
      }

    }
  }
}
